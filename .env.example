# Copy to .env.local. Without these the site runs in preview mode (no live reservations / host).
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Edge Function secrets are set with `supabase secrets set`, never here:
#   ANTHROPIC_API_KEY, SUPABASE_SERVICE_ROLE_KEY, ALLOWED_ORIGIN
